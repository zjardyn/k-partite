install.packages("showtext")
install.packages("showtext")
# library(hexSticker)
library(showtext)
font_paths()
font_add(family = "Comic Code")
font_add(family = "Comic Code", regular = "/usr/local/share/fonts/")
font_add(family = "Comic Code", regular = "/usr/local/share/fonts/ComicCode-Regular.otf")
showtext_auto()
sticker(p, package = "btvis", filename = "~/btvis/hex.png",p_size=7, s_x=1, s_y=.8, s_width=0.9, s_height=0.9, )
font_add(family = "ComicCode", regular = "/usr/local/share/fonts/ComicCode-Regular.otf")
showtext_auto()
sticker(p, package = "btvis", filename = "~/btvis/hex.png",p_size=7, s_x=1, s_y=.8, s_width=0.9, s_height=0.9, )
font_add(family = "ComicCode", regular = "/usr/local/share/fonts/ComicCode-Regular.otf")
showtext_auto()
graph_tri %>%
ggraph(layout = graph_tri$l$layout[,2:1]) +
geom_node_point() +
geom_edge_link(aes(colour = colours)) +
geom_node_text(aes(label = name),
hjust = "outward",
vjust = "outward")+
theme_graph(background = "white") +
scale_x_reverse()
graph_tri_s %>%
ggraph(layout = graph_tri$l$layout[,2:1]) +
geom_node_point() +
geom_edge_link(aes(colour = colour_s)) +
geom_node_text(aes(label = name),
hjust = "outward",
vjust = "outward")+
theme_graph(background = "white") +
scale_x_reverse()
